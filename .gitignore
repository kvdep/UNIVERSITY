# Белый список: по умолчанию игнорируем всё, кроме каталогов
*
!*/
!.gitignore

# Разрешенные типы файлов кода и рукописей
!*.ipynb
!*.py
!*.tex
!*.md
!*.bib

# Разрешенные отчетные артефакты в ПЗМО (метрики и сгенерированные графики)
!ПЗМО/**/*.csv
!ПЗМО/**/*.png

# Явные исключения из белого списка (кэш, виртуальные окружения)
__pycache__/
.ipynb_checkpoints/
.venv/
venv/
env/
node_modules/
.idea/
.vscode/

# Промежуточные файлы сборки LaTeX
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# Чекпоинты моделей и бинарные веса
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
checkpoints/

# Служебные папки тестов окружения
tests/
ВТСК/*
Программирование/Практикум/labs/*
Программирование/Практикум/*
ТОД/dask_perfect/*
UNSORTED/*
